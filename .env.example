# AI Keys — server-side only, NEVER prefix with VITE_
# (Vite inlines every VITE_* var into the public browser bundle)
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase (Client-side)
VITE_FIREBASE_API_KEY=your_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Private beta
# The single code testers type to unlock the tools, shared by everyone in the
# beta. Compared case-insensitively with whitespace stripped; the hyphens matter.
# If this is UNSET the redeem endpoint returns 503 and nobody can join, so it
# must be set on the host before any beta link goes out.
# Note it can be redeemed any number of times - anyone it is forwarded to gets
# in, and rotating it does not evict people who already redeemed, because access
# is a permanent custom claim on the account.
BETA_CODE=MODULR-XXXXX-XXXXX-XXXXX

# Stripe (Phase 2)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Billing kill switch. Anything other than the exact string "true" makes
# /api/create-checkout-session refuse with 503, so payments are closed by
# default and stay closed on any host that forgets this var.
BILLING_ENABLED=false

PORT=3005
