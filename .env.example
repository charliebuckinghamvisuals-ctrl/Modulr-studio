# AI Keys — server-side only, NEVER prefix with VITE_
# (Vite inlines every VITE_* var into the public browser bundle)
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase (Client-side)
VITE_FIREBASE_API_KEY=your_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Private beta
# One code per person, each redeemable ONCE. Comma separated, and each entry may
# carry a `:label` naming who it was issued to - the label never reaches the
# person redeeming, it exists so the server log and the betaCodes document say
# whose code was used rather than just that one was.
# Compared case-insensitively with whitespace stripped; the hyphens matter.
# If neither this nor BETA_CODE is set, redemption returns 503 and nobody can
# join, so it must be set on the host before any beta link goes out.
BETA_CODES=MODULR-AAAAA-BBBBB-CCCCC:Dave,MODULR-DDDDD-EEEEE-FFFFF:Sarah

# Older single-code form, still honoured and merged into the list above. Also
# single use now, so a leaked code cannot be shared around.
BETA_CODE=MODULR-XXXXX-XXXXX-XXXXX

# Stripe (Phase 2)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Billing kill switch. Anything other than the exact string "true" makes
# /api/create-checkout-session refuse with 503, so payments are closed by
# default and stay closed on any host that forgets this var.
BILLING_ENABLED=false

PORT=3005
